{
  "name": "@pulse/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev:stdio": "tsx --env-file-if-exists=.env src/stdio.ts",
    "lint": "eslint . --max-warnings 0",
    "start": "node --env-file-if-exists=.env dist/stdio.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@pulse/protocol": "workspace:*",
    "@pulse/sdk": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pulse/eslint-config": "workspace:*",
    "@pulse/typescript-config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "10.9.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
