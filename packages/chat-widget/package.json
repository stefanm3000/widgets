{
  "name": "@pulse/chat-widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@pulse/sdk": "workspace:*",
    "@radix-ui/react-slot": "1.3.3",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@pulse/eslint-config": "workspace:*",
    "@pulse/typescript-config": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.9.1",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
