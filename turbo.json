{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "HOST",
    "CI",
    "TEST_DATABASE_URL",
    "PORT",
    "NODE_ENV",
    "DATABASE_URL",
    "PULSE_TOKEN_SECRET",
    "PULSE_ALLOWED_ORIGINS",
    "VITE_PULSE_API_URL",
    "VITE_PULSE_PROXY_TARGET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@pulse/partner-vanilla#test": {
      "dependsOn": ["^build", "@pulse/api#build"],
      "cache": false
    }
  }
}
